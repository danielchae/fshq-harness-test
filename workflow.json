{
  "name": "Samus Builder Workflow",
  "description": "Build full-stack application from PRD specifications",
  "version": "1.2.0",
  "executionModes": {
    "swarm": {
      "command": "{claudeFlowCommand}",
      "args": ["swarm", "$(cat {tempPromptFile})"],
      "flags": ["--output-format", "stream-json", "--parallel", "--distributed", "--auto-spawn",
                "--auto-agents", "--max-agents", "10", "--min-agents", "3",
                "--mode", "hierarchical", "--strategy", "research"],
      "promptFormat": "tempfile"
    },
    
    "swarm-development": {
      "command": "{claudeFlowCommand}",
      "args": ["swarm", "$(cat {tempPromptFile})"],
      "flags": ["--output-format", "stream-json", "--parallel", "--distributed", "--auto-spawn",
                "--auto-agents", "--max-agents", "10", "--min-agents", "3",
                "--mode", "hierarchical", "--strategy", "development"],
      "promptFormat": "tempfile"
    },
    
    "swarm-focused": {
      "command": "{claudeFlowCommand}",
      "args": ["swarm", "$(cat {tempPromptFile})"],
      "flags": ["--output-format", "stream-json", "--auto-spawn",
                "--auto-agents", "--max-agents", "2", "--min-agents", "1",
                "--mode", "hierarchical", "--strategy", "development"],
      "promptFormat": "tempfile"
    },
    
    "js-validator": {
      "command": "node",
      "args": ["{scriptFile}"],
      "flags": [],
      "promptFormat": "none"
    }
  },
  "phases": [
    {
      "id": "phase-1-1",
      "name": "PRD Context Mapping",
      "description": "Generate prd-context-map.json by analyzing PRD folder structure",
      "promptFile": "phases/phase-1-1-context-mapping.md",
      "executionMode": "swarm",
      "outputContract": {
        "description": "PRD context mapping for workflow phases",
        "requiredFiles": ["reference/prd-context-map.json"]
      },
      "qualityGate": {
        "file": "gates/gate-1-1-context-map-validator.md",
        "threshold": 0.95
      }
    },
    {
      "id": "phase-1-2",
      "name": "Frontend Implementation Plan",
      "description": "Create frontend manifest with pages, components, routes from UX specs and user stories",
      "promptFile": "phases/phase-1-2-frontend-plan.md",
      "executionMode": "swarm",
      "retryConfig": {
        "maxRetries": 10
      },
      "outputContract": {
        "description": "Frontend task list for Phase 2 implementation",
        "requiredFiles": ["reference/frontend-task-list.json"]
      },
      "qualityGate": {
        "file": "gates/gate-1-2-frontend-plan-validator.md",
        "threshold": 0.95
      }
    },
    {
      "id": "phase-1-3",
      "name": "Backend Implementation Plan",
      "description": "Create backend manifest with Prisma models, Server Actions, data fetchers",
      "promptFile": "phases/phase-1-3-backend-plan.md",
      "executionMode": "swarm",
      "retryConfig": {
        "maxRetries": 10
      },
      "outputContract": {
        "description": "Backend task list for Phase 6 implementation",
        "requiredFiles": ["reference/backend-task-list.json"]
      },
      "qualityGate": {
        "file": "gates/gate-1-3-backend-plan-validator.md",
        "threshold": 0.95
      }
    },
    {
      "id": "phase-1-4",
      "name": "shadcn Components",
      "description": "Map shadcn/ui usage per frontend task, install the components, and document results",
      "promptFile": "phases/phase-1-4-shadcn-components.md",
      "outputContract": {
        "description": "Frontend task list annotated with shadcn components and install notes",
        "requiredFiles": ["reference/frontend-task-list.json"]
      },
      "qualityGate": {
        "file": "gates/gate-1-4-shadcn-validator.md",
        "threshold": 0.95
      }
    },
    {
      "id": "phase-1-5",
      "name": "Frontend E2E Test Generation",
      "description": "Generate Playwright E2E tests from frontend task acceptance criteria",
      "promptFile": "phases/phase-1-5-frontend-test-gen.md",
      "executionMode": "swarm",
      "gitSnapshot": true,
      "outputContract": {
        "description": "Playwright test files for each frontend task",
        "requiredFiles": ["tests/e2e/generated/"]
      },
      "qualityGate": {
        "file": "gates/gate-1-5-frontend-test-validator.js",
        "threshold": 0.95
      }
    },
    {
      "id": "phase-2",
      "name": "Frontend Implementation",
      "description": "Build frontend components and pages from frontend-task-list.json",
      "dynamicPhaseGeneration": {
        "enabled": true,
        "manifestPath": "reference/frontend-task-list.json",
        "mode": "frontend-build",
        "buildUnitTemplate": {
          "promptFile": "phases/phase-2-build-template.md",
          "followUpPrompt": "phases/build-audit-fe.md",
          "qualityGate": {
            "file": "gates/gate-2-composite-validator.js",
            "threshold": 1.0
          }
        }
      }
    },
    {
      "id": "phase-3-1",
      "name": "Frontend UI Review",
      "description": "Deep dive into UI beautification across the frontend",
      "promptFile": "phases/phase-3-1-ui-review.md",
      "qualityGate": {
        "file": "gates/gate-3-1-ui-review-validator.md",
        "threshold": 0.8
      }
    },
    {
      "id": "phase-3-2",
      "name": "Frontend Polish Audit",
      "description": "Evaluate frontend polish checklist items and identify issues needing remediation",
      "promptFile": "phases/phase-3-2-polish-audit.md",
      "executionMode": "swarm",
      "outputContract": {
        "description": "Frontend polish audit findings",
        "requiredFiles": ["reference/fe-polish-findings.json"]
      },
      "qualityGate": {
        "file": "gates/gate-3-2-audit-validator.js",
        "threshold": 1.0
      }
    },
    {
      "id": "phase-3-3",
      "name": "Frontend Polish Remediation",
      "description": "Fix identified frontend polish issues one by one",
      "dynamicPhaseGeneration": {
        "enabled": true,
        "manifestPath": "reference/fe-polish-findings.json",
        "mode": "checklist-remediation",
        "buildUnitTemplate": {
          "promptFile": "phases/phase-3-3-polish-fix.md",
          "qualityGate": {
            "file": "gates/gate-3-3-polish-validator.md",
            "threshold": 0.95
          }
        }
      }
    },
    {
      "id": "phase-4",
      "name": "Frontend Validation & Testing",
      "description": "Test and validate frontend implementation works properly",
      "promptFile": "phases/phase-4-frontend-validation.md",
      "gitSnapshot": true,
      "snapshotName": "preview",
      "outputContract": {
        "description": "Frontend validation report with fixes applied",
        "requiredFiles": []
      },
      "qualityGate": {
        "file": "gates/gate-4-frontend-validator.md",
        "threshold": 0.8
      }
    },
    {
      "id": "phase-5-1",
      "name": "Backend Plan Revision",
      "description": "Revise backend task list based on completed frontend implementation",
      "promptFile": "phases/phase-5-1-backend-plan-revision.md",
      "executionMode": "swarm",
      "outputContract": {
        "description": "Updated backend task list with frontend integration mapping",
        "requiredFiles": ["reference/backend-task-list.json"]
      },
      "qualityGate": {
        "file": "gates/gate-5-1-backend-plan-validator.md",
        "threshold": 0.95
      }
    },
    {
      "id": "phase-5-2",
      "name": "Backend Test Generation",
      "description": "Generate Vitest unit/integration tests from backend task acceptance criteria",
      "promptFile": "phases/phase-5-2-backend-test-gen.md",
      "executionMode": "swarm",
      "outputContract": {
        "description": "Vitest test files for each backend task",
        "requiredFiles": ["tests/backend/"]
      },
      "qualityGate": {
        "file": "gates/gate-5-2-backend-test-validator.js",
        "threshold": 0.95
      }
    },
    {
      "id": "phase-6",
      "name": "Backend Implementation",
      "description": "Build backend components from backend-task-list.json",
      "dynamicPhaseGeneration": {
        "enabled": true,
        "manifestPath": "reference/backend-task-list.json",
        "mode": "backend-build",
        "buildUnitTemplate": {
          "promptFile": "phases/phase-6-build-template.md",
          "followUpPrompt": "phases/build-audit-be.md",
          "qualityGate": {
            "file": "gates/gate-6-composite-validator.js",
            "threshold": 1.0
          }
        }
      }
    },
    {
      "id": "phase-7-1",
      "name": "Backend Integration Fix",
      "description": "Fix backend integration issues and validate the backend integrates correctly",
      "promptFile": "phases/phase-7-1-backend-integration-fix.md",      "gitSnapshot": true,
      "outputContract": {
        "description": "Backend integration fixes applied; integration gate should pass",
        "requiredFiles": []
      },
      "qualityGate": {
        "file": "gates/gate-7-1-integration-validator.js",
        "threshold": 0.95
      }
    },
    {
      "id": "phase-7-2",
      "name": "Full Build Polish Audit",
      "description": "Evaluate full build polish checklist items and identify issues needing remediation",
      "promptFile": "phases/phase-7-2-polish-audit.md",
      "executionMode": "swarm",
      "outputContract": {
        "description": "Full build polish audit findings",
        "requiredFiles": ["reference/full-polish-findings.json"]
      },
      "qualityGate": {
        "file": "gates/gate-7-2-audit-validator.js",
        "threshold": 1.0
      }
    },
    {
      "id": "phase-7-3",
      "name": "Full Build Polish Remediation",
      "description": "Fix identified full build polish issues one by one",
      "dynamicPhaseGeneration": {
        "enabled": true,
        "manifestPath": "reference/full-polish-findings.json",
        "mode": "checklist-remediation",
        "buildUnitTemplate": {
          "promptFile": "phases/phase-7-3-polish-fix.md",
          "qualityGate": {
            "file": "gates/gate-7-3-polish-validator.md",
            "threshold": 0.95
          }
        },
        "finalPhases": [
          {
            "id": "completion-snapshot",
            "name": "Final Build Snapshot",
            "description": "Create final git snapshot after all polish and fixes complete",
            "gitSnapshot": true,
            "snapshotName": "final"
          }
        ]
      }
    }
  ],
  "settings": {
    "checkInterval": false,
    "progressMonitoring": false,
    "outputDirectory": ".",
    "namespace": "samus-builder",
    "maxRetries": 5,
    "retrySystem": {
      "enabled": true,
      "enableResume": true,
      "enableFailureContext": true,
      "maxRetries": 5
    },
    "directAgent": {
      "provider": "claude",
      "continuousTestingProvider": "gemini",
      "providers": {
        "claude": {
          "phaseCommand": {
            "command": "claude",
            "args": ["--print", "--output-format", "stream-json", "$(cat {tempPromptFile})"],
            "flags": ["--model", "claude-opus-4-5-20251101", "--verbose", "--dangerously-skip-permissions", "--mcp-config", ".mcp.json"]
          },
          "gateCommand": {
            "command": "claude",
            "args": ["$(cat {tempPromptFile})"],
            "flags": ["--output-format", "json", "--dangerously-skip-permissions", "--mcp-config", ".mcp.json"]
          },
          "sessionCommand": {
            "command": "claude",
            "args": ["--print", "--output-format", "json", "--dangerously-skip-permissions", "--mcp-config", ".mcp.json", "--session-id", "{{SESSION_ID}}"]
          },
          "resumeCommand": {
            "command": "claude",
            "args": ["--print", "--output-format", "json", "--dangerously-skip-permissions", "--mcp-config", ".mcp.json", "--resume", "{{SESSION_ID}}"]
          }
        },
        "gemini": {
          "phaseCommand": {
            "command": "gemini",
            "args": ["--model", "gemini-3-pro-preview", "--output-format", "json"],
            "promptSource": "tempfile",
            "pipePrompt": true
          },
          "gateCommand": {
            "command": "gemini",
            "args": ["--model", "gemini-3-pro-preview", "--output-format", "json"],
            "promptSource": "tempfile",
            "pipePrompt": true
          },
          "sessionCommand": {
            "command": "gemini",
            "args": ["--model", "gemini-3-pro-preview", "--output-format", "json", "--yolo"],
            "pipePrompt": true
          },
          "resumeCommand": {
            "command": "gemini",
            "args": ["--model", "gemini-3-pro-preview", "--output-format", "json", "--yolo", "--resume", "latest"],
            "pipePrompt": true
          }
        }
      }
    }
  }
}
