# =============================================================================
# Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.
# DO NOT commit .env files with real secrets to git.

# =============================================================================
# Database (Required)
# =============================================================================
# Local development:
DATABASE_URL="postgresql://postgres:password@localhost:5432/database?schema=public"

# Railway deployment:
# Railway auto-provides DATABASE_URL when you add a PostgreSQL service.
# Use the private URL (postgres.railway.internal) for internal connections.

# =============================================================================
# Auth.js (Required)
# =============================================================================
# Generate secret with: openssl rand -base64 32
AUTH_SECRET="your-auth-secret-at-least-32-characters-long"

# Local development:
AUTH_URL="http://localhost:3000"

# Railway deployment:
# Set AUTH_URL to your Railway app's public domain, e.g.:
# AUTH_URL="https://your-app-name.up.railway.app"

# =============================================================================
# Supabase Storage (Required for file uploads)
# =============================================================================
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-supabase-anon-key"

# Storage prefix - use different values per environment to avoid conflicts
# e.g., "local", "staging", "production"
NEXT_PUBLIC_STORAGE_PREFIX="default"

# =============================================================================
# Build Options
# =============================================================================
# Skip environment validation during builds (useful for CI/CD)
# SKIP_ENV_VALIDATION=1
