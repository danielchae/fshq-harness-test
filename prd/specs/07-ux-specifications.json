  "user_flow_maps": [
    {
      "flow_name": "League Connection Journey",
      "entry_points": ["Landing page CTA", "Dashboard connect button", "Direct URL /connect-league", "Email invitation link"],
      "decision_points": [
        {
          "condition": "League ID validation",
          "branches": {
            "valid": "Show league confirmation",
            "invalid": "Show error, allow retry",
            "already_connected": "Offer to join existing league"
          }
        },
        {
          "condition": "User confirms league",
          "branches": {
            "confirm": "Start sync process",
            "cancel": "Return to league ID input"
          }
        },
        {
          "condition": "Sync completion",
          "branches": {
            "success": "Create league, redirect to onboarding",
            "partial_failure": "Show warning, allow continue",
            "critical_failure": "Show error, offer retry"
          }
        }
      ],
      "exit_points": ["League successfully connected", "User cancels wizard", "Critical error occurred"],
      "view_sequence": ["LeagueConnectionWizard (Step 1: Input)", "LeagueConnectionWizard (Step 2: Confirmation)", "LeagueConnectionWizard (Step 3: Sync Progress)", "RoleSelectionOnboarding"],
      "error_handling": [
        {
          "error": "Invalid league ID",
          "recovery": "Show inline error, highlight input field, provide help text with examples",
          "user_action": "Correct input and retry"
        },
        {
          "error": "League already connected",
          "recovery": "Show existing league details, offer join button",
          "user_action": "Join existing league or go back"
        },
        {
          "error": "Sleeper API timeout",
          "recovery": "Show loading message, automatic retry with exponential backoff",
          "user_action": "Wait for retry or manual retry"
        },
        {
          "error": "Sync failure",
          "recovery": "Preserve partial sync data, show detailed error, offer manual retry",
          "user_action": "Retry sync or contact support"
        }
      ]
    },
    {
      "flow_name": "Team Claiming Journey",
      "entry_points": ["Onboarding flow after league connection", "League settings team assignment", "Admin invitation with pre-assigned team", "Direct navigation to /leagues/{slug}/claim-team"],
      "decision_points": [
        {
          "condition": "Role selection",
          "branches": {
            "manager": "Show team claiming interface",
            "fan": "Skip team claiming, proceed to tour"
          }
        },
        {
          "condition": "Sleeper user validation",
          "branches": {
            "valid_match": "Auto-approve claim",
            "invalid_match": "Reject claim, show error",
            "ambiguous_match": "Queue for admin approval",
            "no_sleeper_data": "Queue for admin approval"
          }
        },
        {
          "condition": "Admin approval (if required)",
          "branches": {
            "approved": "Link team to user",
            "rejected": "Notify user with reason"
          }
        }
      ],
      "exit_points": ["Team successfully claimed", "Claim pending admin approval", "Claim rejected", "User skips as fan"],
      "view_sequence": ["RoleSelectionOnboarding", "TeamClaimingInterface", "ValidationSpinner", "SuccessConfirmation or ErrorMessage or PendingApproval"],
      "error_handling": [
        {
          "error": "Sleeper username mismatch",
          "recovery": "Show validation error with expected vs actual username, suggest contacting admin",
          "user_action": "Try different team or contact admin"
        },
        {
          "error": "Team already claimed",
          "recovery": "Show who claimed the team, suggest alternatives",
          "user_action": "Select different team or contact admin for co-manager setup"
        },
        {
          "error": "Validation API failure",
          "recovery": "Default to pending approval, notify admin",
          "user_action": "Wait for admin review"
        }
      ]
    },
    {
      "flow_name": "Commissioner Content Publishing",
      "entry_points": ["Commissioner Desk navigation", "Weekly content reminder notification", "Direct URL /leagues/{slug}/desk", "Quick action button in feed"],
      "decision_points": [
        {
          "condition": "Week selection",
          "branches": {
            "current_week": "Load current week matchups and teams",
            "past_week": "Load historical data, mark read-only",
            "future_week": "Show placeholder, limited editing"
          }
        },
        {
          "condition": "Content type selection",
          "branches": {
            "power_rankings": "Show rankings editor with drag-drop",
            "matchup_predictions": "Show predictions form with featured matchup",
            "commissioner_post": "Show rich text editor"
          }
        },
        {
          "condition": "Content validation",
          "branches": {
            "valid": "Enable publish button",
            "invalid": "Show validation errors, disable publish",
            "incomplete": "Show progress indicator, allow save draft"
          }
        },
        {
          "condition": "Publish action",
          "branches": {
            "success": "Create feed moments, update pages, show confirmation",
            "failure": "Rollback changes, preserve draft, show error"
          }
        }
      ],
      "exit_points": ["Content published successfully", "Draft saved", "User discards changes", "Publish failed"],
      "view_sequence": ["CommissionerDeskPage", "WeekSelector", "ContentEditor (Rankings/Predictions/Post)", "Preview", "PublishConfirmation"],
      "error_handling": [
        {
          "error": "Validation error (missing required fields)",
          "recovery": "Highlight missing fields, show inline errors, prevent publish",
          "user_action": "Complete required fields"
        },
        {
          "error": "Autosave failure",
          "recovery": "Queue changes in localStorage, retry on next interval, show warning banner",
          "user_action": "Continue editing, manual save available"
        },
        {
          "error": "Publish failure",
          "recovery": "Rollback all changes, preserve draft state, show detailed error with retry option",
          "user_action": "Fix issue and retry publish"
        },
        {
          "error": "Browser crash during editing",
          "recovery": "Restore draft from localStorage on next session, show recovery banner",
          "user_action": "Review recovered content, continue editing or discard"
        }
      ]
    },
    {
      "flow_name": "Pick'ems Submission Flow",
      "entry_points": ["Pick'ems navigation tab", "Pick'ems reminder notification", "Direct URL /leagues/{slug}/pickems", "Week matchup completion prompt"],
      "decision_points": [
        {
          "condition": "Week selection",
          "branches": {
            "current_week_unlocked": "Show editable pick form",
            "current_week_locked": "Show locked picks, reveal others",
            "future_week": "Show preview, picks disabled",
            "past_week": "Show graded results"
          }
        },
        {
          "condition": "Pick submission",
          "branches": {
            "all_picks_made": "Enable submit button",
            "partial_picks": "Allow submit with confirmation",
            "no_picks": "Disable submit"
          }
        },
        {
          "condition": "Lock time",
          "branches": {
            "before_lock": "Editable, show countdown",
            "at_lock": "Lock picks, reveal all picks",
            "after_lock": "Read-only, show results when available"
          }
        },
        {
          "condition": "Grading completion",
          "branches": {
            "all_graded": "Show correct/incorrect, update leaderboard",
            "partially_graded": "Show available results, pending indicator",
            "stat_correction": "Re-grade affected picks, show correction badge"
          }
        }
      ],
      "exit_points": ["Picks submitted successfully", "Lock time passed with picks", "Lock time passed without picks", "Grading completed"],
      "view_sequence": ["PickemsSubmissionPage", "WeekSelector", "MatchupPickCards", "SubmitConfirmation", "LockedPicksView", "GradedResultsView"],
      "error_handling": [
        {
          "error": "Submission failure before lock",
          "recovery": "Preserve picks in localStorage, retry automatically, show retry banner",
          "user_action": "Wait for automatic retry or manual retry"
        },
        {
          "error": "Lock time passed during submission",
          "recovery": "Reject submission, show lock time error, display locked picks",
          "user_action": "View locked picks, wait for grading"
        },
        {
          "error": "Network offline during editing",
          "recovery": "Queue picks locally, show offline indicator, sync when online",
          "user_action": "Continue making picks, auto-sync on reconnect"
        },
        {
          "error": "Grading failure",
          "recovery": "Queue for manual grading, show pending status, retry on next cycle",
          "user_action": "Wait for grading completion"
        }
      ]
    },
    {
      "flow_name": "Member Engagement Flow (Comments & Reactions)",
      "entry_points": ["Feed moment click", "Moment detail page", "Notification click", "Direct link to moment"],
      "decision_points": [
        {
          "condition": "User authentication",
          "branches": {
            "authenticated": "Show comment form and reaction buttons",
            "guest": "Show login prompt on interaction"
          }
        },
        {
          "condition": "Comment submission",
          "branches": {
            "valid": "Post comment, show optimistically, send notification",
            "invalid": "Show validation error",
            "rate_limited": "Show rate limit message, disable submit"
          }
        },
        {
          "condition": "Reaction addition",
          "branches": {
            "not_reacted": "Add reaction, update count",
            "already_reacted": "Remove reaction, update count"
          }
        }
      ],
      "exit_points": ["Comment posted successfully", "Reaction added", "User cancels", "Rate limit reached"],
      "view_sequence": ["NewsfeedPage or MomentDetailPage", "CommentThread", "CommentComposer", "ReactionPicker"],
      "error_handling": [
        {
          "error": "Comment submission failure",
          "recovery": "Rollback optimistic update, show error banner, preserve comment text for retry",
          "user_action": "Retry submission"
        },
        {
